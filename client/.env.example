# ── StormLink client configuration ───────────────────────────────────────────
# Google OAuth (NextAuth.js). Leave empty to hide the Google button and use
# demo sign-in instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth session secret + base URL of the client app
NEXTAUTH_SECRET=change-me-to-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Base URL of the Express API (used by server-side rewrites)
STORMLINK_API_URL=http://localhost:4000
