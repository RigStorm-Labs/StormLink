# ── StormLink API configuration ──────────────────────────────────────────────
# Port for the Express API server
PORT=4000

# MongoDB Atlas connection string. Leave empty to run with the built-in
# in-memory store (auto-persisted to server/data/stormlink.json) — great for
# local development and previews.
MONGODB_URI=

# Secret used to sign JWT session tokens. Use a long random string in prod!
JWT_SECRET=change-me-to-a-long-random-string

# How long issued tokens stay valid
JWT_EXPIRES_IN=7d

# Comma-separated list of Google emails that should receive the Admin role
ADMIN_EMAILS=
